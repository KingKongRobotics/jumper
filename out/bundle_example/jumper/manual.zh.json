  "bundle": "jumper",
  "source": "由 scripts/deploy.py 在打包时生成：各任务的 controls.yaml（取自其契约），以及 deploy/manifests.json 里的模式切换键（以控制器自己报告的为准）。手柄和键盘是两条互不相关的操作路径，分别列出。",
  "modes": [
    {
      "mode": "locomotion",
      "task": "jumper.posture",
      "default": true,
      "summary": "机器人开机后所处的模式；没有要求进入其他模式时，也回到这里。",
      "enter": "开机即处于此模式。",
      "leave": "切换到其他模式即离开此模式。",
      "keyboard": "按住一个键，它控制的量随按住的时间逐渐加大（2 秒后到满量），松开立即回到静止；身高也一样：摇杆是移动身高，键盘是摆出高/低站姿，松开回到站立高度。",
      "controls": [
        {
          "control": "Ly",
          "pad": "左摇杆上下",
          "does": "上：前进；下：后退"
        },
        {
          "control": "Lx",
          "pad": "左摇杆左右",
          "does": "左：左移；右：右移"
        },
        {
          "control": "Ry",
          "pad": "右摇杆上下",
          "does": "上：低头；下：抬头；按住右摇杆（R3）时——上：升高（持续移动，松开即停留）；下：降低（持续移动，松开即停留）"
        },
        {
          "control": "Rx",
          "pad": "右摇杆左右",
          "does": "左：推到一半以内是左扭，再往外推是左转；右：推到一半以内是右扭，再往外推是右转；按住右摇杆（R3）时——左：横滚，左侧低；右：横滚，右侧低"
        },
        {
          "control": "R3",
          "pad": "右摇杆按下（R3）",
          "does": "按住切换到摇杆的另一层；轻点（按下后摇杆不动就松开）把身高恢复到站立高度"
        },
        {
          "control": "B",
          "pad": "B",
          "does": "全部松开：所有操作回到静止"
        }
      ],
