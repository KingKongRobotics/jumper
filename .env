# Default settings for mjrl-lab.
#
# Precedence: command line > shell environment > .env.local > .env > the
# argument's own default. The command line wins whenever it is given; when
# nothing supplies a value and the argument has no built-in default (MJRL_TASK,
# for one), the entry point errors and says what is missing.
#
# Where a key has a fixed set of values -- the on/off switches, and
# auto/warp/native -- the value is read **case-insensitively** (a switch also
# takes true/false, yes/no and 1/0), and anything outside the set is an
# **error** rather than a fall back to the default: a setting that is silently
# ignored reads as a feature that does not work.
#
# This file **is committed** and holds project-level defaults. Personal
# overrides and secrets belong in .env.local, which is not (see .gitignore).

# ── Which task ─────────────────────────────────────────────────────────
# Task id; see `python scripts/train.py --list`.
# No built-in default: left empty here and not given on the command line, the
# entry point errors.
MJRL_TASK=jumper.tripod

# Which model asset: an asset name registered by the task, or an .xml / .mjcf
# path. Empty means the task's default asset (the first one it declares).
MJRL_MODEL=jumper

# How the world looks: ground, sky and lights. See `--list` for the choices.
# Empty leaves the task's own configuration untouched.
MJRL_SCENE=

# ── Task settings ──────────────────────────────────────────────────────
# jumper.swing: which angle the swing is released from, in degrees. One value
# releases every episode from there; two are a range drawn from uniformly per
# episode, with the sign randomised either way.
#
# Empty keeps each mode's own default: the training range 0,45 -- so part of the
# batch is handed a swing and part has to build one -- and a dead stop when
# replaying, because a robot dropped onto a 45 degree swing looks exactly like
# one that has learnt to pump.
#
# The matching flag is --swing-angle. It is declared by the task rather than by
# scripts/_cli.py, which is one parser shared by train, play and export and is
# not allowed any task's vocabulary; see cli_args in tasks/jumper/swing/__init__.py.
MJRL_SWING_ANGLE=

# jumper.swing: the rope length, in metres, from the beam to the plank. One value
# hangs every swing at it; two are a range drawn from per episode, per
# environment.
#
# Empty draws from the whole 0.6-1.8 m the frame can be rigged at, which is what
# training wants: the period runs 1.50 to 2.65 s across that range, so a policy
# cannot learn one rhythm and call it swinging. It is also the replay default,
# unlike the release angle -- there is no neutral length the way a dead stop is a
# neutral angle. Pin it with one value to ask whether a policy really generalises.
#
# One thing to know before watching a replay: **the viewer draws the ropes slack
# at any length but 1.35 m**, looping them below the plank. The physics is right --
# all four ropes are in tension, measured -- but the drawing model is compiled at
# the nominal length and never learns this episode's. MJRL_SWING_LENGTH=1.35, or
# --swing-length 1.35, draws them straight. See the note in
# tasks/jumper/swing/env_cfg.py next to env_spacing.
MJRL_SWING_LENGTH=

# ── The rough scene's own settings ─────────────────────────────────────
# Both have a matching flag, --terrain-row and --terrain-col, and like the swing
# pair above **the scene declares them, not the parser**: scripts/_cli.py is one
# parser for three entry points and a scene's vocabulary in it is the layering
# tests/test_log_layout.py forbids. See cli_args in scenes/rough.py.
#
# --scene rough generates a 10 x 7 grid: ten difficulty rows, one column per
# sub-terrain, which a run normally meets all of through the terrain curriculum.
# These pin it to one tile, for testing one difficulty or one kind of ground.
#
# The row, 0 (flat) to 9 (hardest). Empty is the full ladder. Pinned, the terrain
# curriculum has nowhere to promote to, which is the point.
MJRL_TERRAIN_ROW=

# The column, by sub-terrain name: flat, pyramid_stairs, pyramid_stairs_inv,
# hf_pyramid_slope, hf_pyramid_slope_inv, random_rough, wave_terrain. Empty is
# the mix. A name that matches none of them raises and lists these.
MJRL_TERRAIN_COL=

# ── Backend and device ─────────────────────────────────────────────────
# auto | warp | native
#   warp   · cuda   the GPU workhorse
#   warp   · cpu    on Apple Silicon with the `metal` extra: the tensors stay on
#                   the CPU and the simulation runs on the Apple GPU (metal:0)
#   native · cpu    real training without a GPU (multi-threaded native MuJoCo)
# auto = detect: warp:cuda if CUDA is available, else warp with the simulation
# on metal:0 if Warp lists an Apple GPU, otherwise native:cpu.
# An explicit choice **never falls back** -- asking for a GPU on a machine
# without one is an error, not a silent switch to CPU.
MJRL_BACKEND=auto

# auto | cuda:0 | cpu. The torch device: where the environment's tensors live.
# There is no metal here -- torch has none -- so on Apple Silicon it is cpu and
# the two keys below say where physics and learning happen.
MJRL_DEVICE=auto

# Where physics runs when the backend is warp and MJRL_DEVICE is cpu. Empty
# takes metal:0 when Warp lists one (the `metal` extra) and cpu otherwise.
# `cpu` keeps the simulation off the Apple GPU: warp's serial cpu device, the
# debugging path. `metal:0` where Warp lists none is an error.
MJRL_SIM_DEVICE=

# Where the policy learns when the simulation is on metal:0. Empty takes mps
# when torch has it (learning measured 6.7 s -> 2.0 s per iteration at 4096
# environments on an M3 Max) and the torch device otherwise; `cpu` keeps the
# policy there. Ignored off Metal: the policy learns on MJRL_DEVICE.
MJRL_AGENT_DEVICE=

# Training's number of parallel environments. Empty takes the backend's default
# (warp 4096 / native 64).
# Note: changing it changes PPO's effective batch size, so the
# hyper-parameters need recalibrating.
MJRL_NUM_ENVS=4096

# play.py's number of environments: how many robots are on screen, every one
# running the same policy. A separate key because it is a separate quantity --
# it has no batch to change, and training's 4096 is a field of copies nobody
# asked to watch. Empty means 1.
MJRL_PLAY_NUM_ENVS=1

# Thread count for the native backend. 0 means "let it choose", which is the
# core count capped at 8 -- **not** every core. About half of a native step is
# serial, so past ~8 workers extra threads only add overhead: measured on a
# 32-core i9-14900KF at 64 environments, 8 threads 15.3 ms/step against 22.4 for
# every core. Raise it here if your machine measures otherwise.
MJRL_CPU_THREADS=0
# native: whether to strip visual-only meshes. Domain randomisation copies one
# MjModel per environment, and most of jumper's 76 MiB per copy is visual meshes
# that are never used (5 MiB once stripped; measured 75.5 / 4.9 MiB with
# MuJoCo 3.11, model_slim.model_nbytes on assets/jumper/jumper.xml).
# auto = strip once the per-environment models exceed 2 GiB; on / off force it.
# Cost: camera sensors then see collision geometry rather than appearance
# meshes (the live viewer keeps a full model of its own and is unaffected).
MJRL_STRIP_VISUAL=auto

# ── TensorBoard ────────────────────────────────────────────────────────
# on | off. Training starts a TensorBoard server on its own log directory and
# prints the URL; off leaves that to you. This is the setting for good:
# --no-tensorboard turns it off for a single run and --tensorboard turns it
# back on over an `off` here.
MJRL_TENSORBOARD=on

# Preferred port. A port already in use is skipped, so a second run lands on
# the next one instead of failing. It binds to localhost only -- to reach it
# from another machine, forward the port: ssh -L 6006:localhost:6006 <host>
MJRL_TB_PORT=6006
